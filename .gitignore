# =========================================================
# Données — règles
# =========================================================
# Par défaut on exclut toutes les données sensibles...
*.csv
*.xlsx
*.xls
*.parquet
*.db
*.sqlite
*.duckdb

# Aucune donnée n'est versionnée : le dossier data/ ne garde que son README.
data/*
!data/README.md

# Outils et audits réservés à l'encadrant (jamais publiés)
_confidentiel/

# Dossier remis aux étudiants (contient les données)
Dossier_Etudiants/

# Note de travail des tuteurs
pi programme.docx

# Modèles ML sauvegardés (souvent volumineux)
*.pkl
*.joblib
*.h5
*.onnx

# Fichiers Power BI (volumineux, peuvent contenir des données)
*.pbix

# =========================================================
# Environnements et caches Python
# =========================================================
venv/
env/
.venv/
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# =========================================================
# Fichiers d'environnement et secrets
# =========================================================
.env
.env.local
*.secret
credentials.json

# =========================================================
# IDE / Système
# =========================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
.~lock.*

# =========================================================
# Logs et sorties
# =========================================================
*.log
logs/
mlruns/
outputs/
